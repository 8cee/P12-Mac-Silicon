{
  "name": "p12-mac-silicon",
  "version": "1.0.15",
  "private": true,
  "description": "P-12 FULL15 Apple Silicon sampler/sequencer with native JUCE VST3 hosting",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist:mac:arm64": "npm test && npm run build:native:mac && electron-builder --mac dmg zip --arm64 --publish never --config.directories.output=dist-mac-arm64",
    "test": "node scripts/verify-distribution.cjs",
    "build:native:mac": "bash scripts/build-native-mac.sh"
  },
  "devDependencies": {
    "electron": "44.2.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "com.p12.sampler.silicon",
    "productName": "P-12 v1.0",
    "files": [
      "P-12.html",
      "piano-detached.html",
      "playlist-detached.html",
      "main.js",
      "preload.js",
      "vendor/jszip.min.js",
      "vendor/LICENSE-JSZIP-MIT.txt",
      "mixer-detached.html",
      "transport-controller.cjs",
      "recovery-worker.cjs",
      "build/icon.png"
    ],
    "artifactName": "P-12-FULL15-Mac-Silicon-${version}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.music",
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "P-12 uses microphone/audio-input access when you choose to record samples."
      },
      "icon": "build/icon.png",
      "identity": "-"
    },
    "dmg": {
      "title": "P-12 v1.0"
    },
    "extraResources": [
      {
        "from": "native/P-12 VST Host.app",
        "to": "native/P-12 VST Host.app",
        "filter": [
          "**/*"
        ]
      }
    ]
  }
}
